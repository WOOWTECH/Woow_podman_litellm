# Per-host settings for the LiteLLM gateway. scripts/install.sh copies this file to
# ~/.config/litellm/litellm.env (mode 0600) on the first install and renders the values
# into the Quadlet units. Edit that copy, then re-run install.sh: a changed value restarts
# what uses it, an unchanged re-run restarts nothing.
#
# Plain KEY=VALUE lines: no quotes, no `export`, no trailing comments, no spaces.

# Publish address and port of the proxy (/v1 API and the Admin UI at /ui). Loopback only
# by default: put a reverse proxy or a tunnel on this host in front of it.
LITELLM_BIND=127.0.0.1
LITELLM_PORT=4000

# DEBUG | INFO | ERROR. INFO matches the k3s deployment; ERROR is LiteLLM's production advice.
LITELLM_LOG=INFO

# --- keys: install.sh turns these into podman secrets ---------------------------------
# OpenRouter key (openrouter.ai/keys). Required on the first install. A new value here is
# copied into the secret litellm-openrouter-api-key on the next install run, which then
# restarts the proxy. Once installed you may blank it: an empty value keeps the secret.
OPENROUTER_API_KEY=REPLACE_ME

# Optional: import existing keys instead of generating them (for example when moving a
# database from another host). Leave blank to let install.sh generate them once.
# The master key is the Admin UI password (user admin) and must start with sk-.
# The salt key encrypts every provider credential in the database: it is set once and
# never replaced; install.sh refuses a value that differs from the existing secret.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
