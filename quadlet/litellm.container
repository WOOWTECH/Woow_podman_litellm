# litellm: the LiteLLM OpenAI-compatible proxy (the WOOWTECH gateway itself).
#
# Rendered by scripts/install.sh from ~/.config/litellm/litellm.env (the double-at tokens
# are listed in quadlet/render-vars). Edit the env file and re-run install.sh; do not edit
# the installed copy. Published on @@LITELLM_BIND@@:@@LITELLM_PORT@@.
#
# Secrets are podman secrets created by install.sh; none is in this file, in the env file
# after you blank it, or in config.yaml (which dereferences os.environ/NAME).
[Unit]
Description=LiteLLM proxy (WOOWTECH gateway, OpenRouter-backed)
Documentation=https://github.com/WOOWTECH/Woow_podman_litellm
Documentation=https://docs.litellm.ai/docs/proxy/prod
# A real readiness gate: litellm-postgres only turns active after its ExecStartPost=
# saw Postgres accept TCP connections. Requires= alone orders nothing; After= does.
Requires=litellm-postgres.service
After=litellm-postgres.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
ContainerName=litellm
# Same pinned tag as the k3s deployment (Woow_k3s_litellm): identical gateway behaviour.
Image=ghcr.io/berriai/litellm:v1.83.14-stable
Network=litellm.network
PublishPort=@@LITELLM_BIND@@:@@LITELLM_PORT@@:4000
# One copy of config.yaml, installed by install.sh from config/config.yaml. ":Z" is a
# private SELinux label (ignored on Ubuntu).
Volume=%h/.config/litellm/config.yaml:/app/config.yaml:ro,Z
# Arguments only: the image entrypoint ends in `exec litellm "$@"`. Never set Entrypoint=.
Exec=--config /app/config.yaml --port 4000

Secret=litellm-database-url,type=env,target=DATABASE_URL
Secret=litellm-master-key,type=env,target=LITELLM_MASTER_KEY
# Encrypts every provider credential stored in Postgres. Set once, never rotated; backed
# up by scripts/backup.sh (secrets.env). Losing it makes those credentials unreadable.
Secret=litellm-salt-key,type=env,target=LITELLM_SALT_KEY
Secret=litellm-openrouter-api-key,type=env,target=OPENROUTER_API_KEY
Environment=STORE_MODEL_IN_DB=True
# Disables load_dotenv(): LiteLLM never auto-loads a stray local .env.
Environment=LITELLM_MODE=PRODUCTION
Environment=LITELLM_LOG=@@LITELLM_LOG@@
# Deliberately NOT the k3s value (true): this stack starts on an empty volume and runs
# exactly one proxy, which must run the Prisma migrations itself. With true it would only
# print the SQL, create no tables, and /health/readiness would never pass.
Environment=DISABLE_SCHEMA_UPDATE=false

# The image ships python but not curl. Startup probe (k8s startupProbe): readiness is
# DB-aware and covers the first Prisma migration; 40 x 15 s = 10 minutes of grace.
HealthStartupCmd=python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:4000/health/readiness').status==200 else 1)"
HealthStartupInterval=15s
HealthStartupTimeout=10s
HealthStartupRetries=40
HealthStartupSuccess=1
# Liveness (k3s timings 20 s / 10 s / 6). Never probe plain /health: it calls every
# configured model upstream and costs money on every interval.
HealthCmd=python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:4000/health/liveliness').status==200 else 1)"
HealthInterval=20s
HealthTimeout=10s
HealthRetries=6
HealthStartPeriod=120s
# podman does nothing about an unhealthy container by default; kill lets Restart=always
# bring it back, like a failed livenessProbe.
HealthOnFailure=kill

# k3s limits (cpu 2, memory 2Gi). LiteLLM's docs call ~4Gi per worker a floor: raise this
# first if the proxy is OOM-killed.
PodmanArgs=--memory=2g --cpus=2.0
Label=app=litellm
Label=io.woowtech.stack=litellm-gw
Label=io.woowtech.app=litellm
NoNewPrivileges=true

[Service]
Restart=always
RestartSec=10
# The first boot runs the Prisma migrations; install.sh pre-pulls the image so the
# pull never counts against this.
TimeoutStartSec=600
TimeoutStopSec=60

[Install]
WantedBy=default.target
