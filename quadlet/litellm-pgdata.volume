# The LiteLLM Postgres data directory: keys, teams, users, spend and the encrypted
# provider credentials. A named volume, not a bind mount: podman initialises it with the
# image's ownership (uid 70), which a rootless bind mount would get wrong.
# VolumeName= keeps the name "litellm-pgdata" (Quadlet's default is systemd-<file>).
# It has no size limit: watch the free space of ~/.local/share/containers.
# Deleted only by scripts/uninstall.sh --purge, after a final pg_dump.
[Unit]
Description=Podman volume holding the LiteLLM Postgres data directory

[Volume]
VolumeName=litellm-pgdata
Label=app=litellm-postgres
Label=io.woowtech.stack=litellm-gw
Label=io.woowtech.app=litellm
