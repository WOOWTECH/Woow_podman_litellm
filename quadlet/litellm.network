# Private bridge for litellm and litellm-postgres. Containers resolve each other by
# name (aardvark-dns), so DATABASE_URL points at litellm-postgres:5432. NetworkName= keeps
# the name "litellm-net" instead of Quadlet's default "systemd-litellm".
[Unit]
Description=Podman network for the WOOWTECH LiteLLM gateway

[Network]
NetworkName=litellm-net
Driver=bridge
Label=app=litellm
Label=io.woowtech.stack=litellm-gw
Label=io.woowtech.app=litellm
