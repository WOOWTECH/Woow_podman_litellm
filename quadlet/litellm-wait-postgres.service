# =============================================================================
# litellm-wait-postgres.service
# WOOWTECH / Woow_podman_litellm
# -----------------------------------------------------------------------------
# THIS IS NOT A QUADLET FILE. It is a plain systemd unit and must be installed
# into the ordinary user unit directory:
#
#     ~/.config/systemd/user/litellm-wait-postgres.service
#
# NOT into ~/.config/containers/systemd/ - Quadlet only reads .container,
# .volume, .network, .pod, .kube, .build, .image and .artifact from its search
# paths, so a .service file dropped there is silently ignored and you would get
# "Unit litellm-wait-postgres.service not found". install.sh puts it in the
# right place for you.
# -----------------------------------------------------------------------------
# WHAT IT IS FOR
#   It is the Podman-4.x-compatible ordering fallback, and the direct analogue
#   of the k3s initContainer "wait-for-postgres" (busybox:1.36 running
#   `until nc -z litellm-postgres 5432; do sleep 3; done`).
#
#   On Podman 5.0+ litellm-postgres.container uses `Notify=healthy`, which makes
#   systemd consider that unit "active" only once pg_isready passes - a real
#   health gate that makes this file unnecessary. On Podman 4.4-4.9 that key
#   does not exist (Notify= only accepts true/false there), so the proxy would
#   otherwise start the instant the Postgres *process* spawned, which is too
#   early: Postgres binds its socket during initdb, before it will accept
#   authenticated connections.
#
#   litellm.container pulls this unit in with Wants= (not Requires=), so it is
#   harmless whether or not it is installed, and on a healthy Podman 5.x host it
#   simply succeeds on its first poll.
#
# WHY THE CHECK IS BETTER THAN THE k3s ORIGINAL
#   `nc -z` goes green as soon as a TCP listener binds. This unit instead starts
#   a throwaway container ON THE SAME PODMAN NETWORK and runs pg_isready against
#   litellm-postgres:5432, which additionally proves that (a) aardvark-dns
#   resolves the hostname the DATABASE_URL uses and (b) the server is answering
#   the Postgres protocol, not merely holding a socket open. It reuses the
#   postgres:16-alpine image the stack already pulls, so - unlike the k3s
#   version - it adds no busybox image to pin and patch.
#
# NOTE ON $$
#   In a systemd unit file "$$" produces a literal "$". The loop below is
#   ordinary POSIX sh once systemd has unescaped it.
#
# NOTE ON THE PODMAN PATH
#   ExecStart uses the absolute path /usr/bin/podman because a systemd user
#   unit's PATH is minimal. install.sh rewrites this to whatever
#   `command -v podman` reports on your host. If you install this file by hand
#   and podman lives elsewhere (e.g. /usr/local/bin/podman), edit the path.
# =============================================================================

[Unit]
Description=Wait until the LiteLLM Postgres database accepts connections
Documentation=https://github.com/WOOWTECH/Woow_podman_litellm

# Hard dependency + ordering on the database container unit generated by
# quadlet/litellm-postgres.container.
Requires=litellm-postgres.service
After=litellm-postgres.service

# The network is generated by quadlet/litellm.network as litellm-network.service.
# Ordering only - litellm-postgres.service already Requires= it.
After=litellm-network.service

# Do not thrash if the database is genuinely broken.
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot

# Keep the unit "active (exited)" after the poll succeeds so that units ordered
# After= it are released and systemd does not try to re-run it on every
# dependency evaluation.
RemainAfterExit=yes

# BOUNDED retry loop: 60 attempts x 3s = 180 seconds, then a non-zero exit that
# fails the unit loudly instead of hanging forever. Keep TimeoutStartSec above
# that ceiling plus a little slack for the container spawn.
ExecStart=/usr/bin/podman run --rm --network litellm-net --name litellm-wait-postgres docker.io/library/postgres:16-alpine sh -c 'i=0; while [ $$i -lt 60 ]; do if pg_isready -h litellm-postgres -p 5432 -U litellm -d litellm >/dev/null 2>&1; then echo "litellm-postgres is accepting connections"; exit 0; fi; echo "postgres not ready, sleeping 3s ($$i/60)"; i=$$((i + 1)); sleep 3; done; echo "TIMED OUT after 180s waiting for litellm-postgres:5432" >&2; exit 1'

# ALTERNATIVE ExecStart - no second container, polls through the running
# database container instead. Use this if your host forbids extra containers or
# if the throwaway container's name ever collides. It does not exercise DNS.
#ExecStart=/bin/sh -c 'i=0; while [ $$i -lt 60 ]; do if /usr/bin/podman exec litellm-postgres pg_isready -U litellm -d litellm >/dev/null 2>&1; then echo "litellm-postgres is accepting connections"; exit 0; fi; echo "postgres not ready, sleeping 3s"; i=$$((i + 1)); sleep 3; done; echo "TIMED OUT after 180s waiting for litellm-postgres" >&2; exit 1'

# LITERAL k3s MIRROR - busybox + `nc -z`, kept only for reference. It is weaker
# (TCP-only) and pulls an extra image. Not recommended.
#ExecStart=/usr/bin/podman run --rm --network litellm-net docker.io/library/busybox:1.36 sh -c 'until nc -z litellm-postgres 5432; do echo "postgres not ready, sleeping 3s"; sleep 3; done; echo "postgres is up"'

# Must exceed the loop ceiling (180s) plus image-pull time on a cold host.
TimeoutStartSec=300

# Remove a stale throwaway container left behind by a previous killed run, so a
# retry cannot fail with "container name is already in use". "-" prefixes mean
# a non-zero exit is ignored.
ExecStartPre=-/usr/bin/podman rm -f -i litellm-wait-postgres
ExecStopPost=-/usr/bin/podman rm -f -i litellm-wait-postgres

# Journal identity, so `journalctl --user -t litellm-wait-postgres` works.
SyslogIdentifier=litellm-wait-postgres

# No [Install] section on purpose.
#   This unit is not meant to be started or enabled on its own - litellm.service
#   pulls it in via Wants=. Adding [Install] WantedBy=default.target would make
#   it run at every boot independently of the proxy, which is pointless and
#   would surface a spurious "failed" unit if the stack is intentionally stopped.
