# litellm-postgres: PostgreSQL 16 for the WOOWTECH LiteLLM gateway. Not published.
#
# Readiness gate: podman 4.9.3 silently ignores Notify=healthy (the generated unit gets
# --sdnotify=conmon, so "started" means "container started"). ExecStartPost= below keeps
# this unit "activating" until Postgres accepts TCP connections, so the Requires=/After=
# in litellm.container really waits for a usable database. It replaces the old
# litellm-wait-postgres.service (same probe, no extra container, no soft Wants=).
#
# Least privilege: this container gets only its own password, as a secret file. The
# provider, master and salt keys never reach it.
[Unit]
Description=PostgreSQL 16 for the WOOWTECH LiteLLM gateway
Documentation=https://github.com/WOOWTECH/Woow_podman_litellm
# Park the unit in "failed" instead of hot-looping on a broken setup (podman has no
# CrashLoopBackOff).
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
ContainerName=litellm-postgres
# Pinned minor version (STANDARD section 3); upgrade = bump here, then scripts/upgrade.sh.
Image=docker.io/library/postgres:16.15-alpine3.24
Network=litellm.network
Volume=litellm-pgdata.volume:/var/lib/postgresql/data
Environment=PGDATA=/var/lib/postgresql/data/pgdata
Environment=POSTGRES_USER=litellm
Environment=POSTGRES_DB=litellm
# Read by initdb on an EMPTY volume only. On an existing volume the role keeps its
# password; change it with scripts/rotate-secrets.sh --db (ALTER ROLE + both secrets).
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/postgres-password
Secret=litellm-postgres-password,type=mount,target=/run/secrets/postgres-password,mode=0400

# TCP probe (-h 127.0.0.1): during first-boot init the entrypoint runs a temporary server
# on the unix socket only, so a socket probe would report "ready" too early.
HealthCmd=pg_isready -h 127.0.0.1 -p 5432 -U litellm -d litellm
HealthInterval=10s
HealthTimeout=5s
HealthRetries=3
# 60 s, so HealthOnFailure=kill cannot kill a slow first initdb on a small host.
HealthStartPeriod=60s
HealthOnFailure=kill

# k3s limits (cpu 1, memory 1Gi). PodmanArgs= because Memory= needs podman 5.5. Rootless
# hosts do not delegate the cpu controller by default, so --cpus may be a no-op there.
PodmanArgs=--memory=1g --cpus=1.0
Label=app=litellm-postgres
Label=io.woowtech.stack=litellm-gw
Label=io.woowtech.app=litellm
NoNewPrivileges=true

[Service]
# A container stopped by systemd is stopped with SIGTERM: an entrypoint that does not
# trap it exits 143 (128+15), which would leave the unit failed after a clean stop.
SuccessExitStatus=143
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=90
ExecStartPost=/usr/bin/timeout 240 /bin/sh -c 'until podman exec litellm-postgres pg_isready -h 127.0.0.1 -p 5432 -U litellm -d litellm >/dev/null 2>&1; do sleep 2; done'

[Install]
WantedBy=default.target
